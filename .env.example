# ==============================================================================
# 〈우리 유형 테스트 v2〉 환경변수 설정 가이드 (.env.example)
#
# 새로운 Supabase 프로젝트 생성 후 아래 값들을 설정하세요.
# Vercel 배포 시 Settings > Environment Variables 에 등록합니다.
# ==============================================================================

# 1. Supabase Project URL (새 Supabase 프로젝트 Project Settings > API > Project URL)
# 예: https://your-new-project-id.supabase.co
SUPABASE_URL=

# 2. Supabase Service Role Key (Project Settings > API > Project API keys > service_role)
# 주의: 반드시 Secret service_role 키를 사용해야 RLS를 안전하게 우회하여 서버리스 함수가 정상 동작합니다.
SUPABASE_SERVICE_ROLE_KEY=

# 3. 관리자 통계 대시보드 비밀번호 (/admin 접근 및 데이터 리셋에 사용)
ADMIN_PASSWORD=
